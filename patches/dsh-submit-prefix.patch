diff --git a/packages/client/ui-conversation/tests/prefix-submit.client.spec.ts b/packages/client/ui-conversation/tests/prefix-submit.client.spec.ts
new file mode 100644
index 0000000000..3b1b18fe74
--- /dev/null
+++ b/packages/client/ui-conversation/tests/prefix-submit.client.spec.ts
@@ -0,0 +1,95 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { Context } from '@deepseek-ai/cordis'
+import { UNDO_COMMAND } from 'lexical'
+import { SessionInputShell, type SessionInputDeps } from '../src/client/input/facade.ts'
+import type { SubmitOutcome } from '../src/client/contract/input.ts'
+
+const first = '我想知道当前工作区的位置'
+const draft = `${first}，然后`
+
+function setup() {
+  const admissions: ((outcome: SubmitOutcome) => void)[] = []
+  const sink = vi.fn<SessionInputDeps['defaultSink']>(() => new Promise<SubmitOutcome>(resolve => admissions.push(resolve)))
+  const shell = new SessionInputShell({
+    actx: {} as Context, defaultSink: sink,
+    commandAttachments: { serialize: async () => [], release() {}, unsupportedNotice: token => token },
+  })
+  shell.setDraft(draft)
+  const send = (mode: 'queue' | 'steer' = 'queue') => shell.actions.submitPrefix!({
+    draftRev: shell.snapshot.draftRev, sendEnd: first.length, consumeEnd: first.length + 1, mode,
+  })
+  return { shell, sink, admissions, send }
+}
+
+describe('native prefix admission', () => {
+  it('sends the original prefix, retains suffix, and prevents undo from resurrecting sent text', async () => {
+    const { shell, sink, admissions, send } = setup()
+    try {
+      const pending = send()
+      expect(sink).toHaveBeenCalledWith(first, [], 'queue', expect.any(AbortSignal))
+      expect(shell.snapshot.draft).toBe('然后')
+      expect(shell.actions.captureInsertion()).toMatchObject({ start: 2, end: 2 })
+      admissions[0]!({ kind: 'success' })
+      expect(await pending).toEqual({ kind: 'accepted' })
+      expect({ message: sink.mock.calls[0]?.[0], remaining: shell.snapshot.draft }).toMatchInlineSnapshot(`
+        {
+          "message": "我想知道当前工作区的位置",
+          "remaining": "然后",
+        }
+      `)
+      shell.editor.dispatchCommand(UNDO_COMMAND, undefined)
+      expect(shell.snapshot.draft).toBe('然后')
+    } finally { shell.dispose() }
+  })
+
+  it('Enter captures the suffix once and waits for the earlier prefix admission', async () => {
+    const { shell, sink, admissions, send } = setup()
+    try {
+      const pending = send()
+      shell.setDraft('然后列一下顶层目录')
+      shell.submit('queue', 'enter')
+      expect(sink).toHaveBeenCalledTimes(1)
+      shell.setDraft('还有一件事')
+      admissions[0]!({ kind: 'success' })
+      await pending
+      await vi.waitFor(() => expect(sink).toHaveBeenCalledTimes(2))
+      expect(sink.mock.calls[1]?.[0]).toBe('然后列一下顶层目录')
+      expect(shell.snapshot.draft).toBe('还有一件事')
+      admissions[1]!({ kind: 'success' })
+    } finally { shell.dispose() }
+  })
+
+  it('rejection restores the prefix and staged Enter without overwriting new typing', async () => {
+    const { shell, sink, admissions, send } = setup()
+    try {
+      const pending = send()
+      shell.setDraft('然后列一下顶层目录。')
+      shell.submit()
+      shell.setDraft('还有一件事')
+      admissions[0]!({ kind: 'error' })
+      expect(await pending).toEqual({ kind: 'error' })
+      expect(shell.snapshot.draft).toBe(`${first}，然后列一下顶层目录。还有一件事`)
+      await Promise.resolve()
+      expect(sink).toHaveBeenCalledTimes(1)
+    } finally { shell.dispose() }
+  })
+
+  it('stale revisions and non-separator consumption leave the editor unchanged', async () => {
+    const { shell, sink } = setup()
+    try {
+      expect(await shell.actions.submitPrefix!({ draftRev: -1, sendEnd: first.length, consumeEnd: first.length, mode: 'queue' })).toEqual({ kind: 'skipped' })
+      expect(await shell.actions.submitPrefix!({ draftRev: shell.snapshot.draftRev, sendEnd: first.length, consumeEnd: draft.length, mode: 'queue' })).toEqual({ kind: 'skipped' })
+      expect(shell.snapshot.draft).toBe(draft)
+      expect(sink).not.toHaveBeenCalled()
+    } finally { shell.dispose() }
+  })
+
+  it('routes steering natively and releases a pending prefix on disposal', async () => {
+    const { shell, sink, send } = setup()
+    const pending = send('steer')
+    expect(sink).toHaveBeenCalledWith(first, [], 'steer', expect.any(AbortSignal))
+    expect(await send()).toEqual({ kind: 'skipped' })
+    shell.dispose()
+    expect(await pending).toEqual({ kind: 'disposed' })
+  })
+})
